# SocialFlow Environment Configuration Example

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Sequelize)
# Format: postgres://username:password@localhost:5432/database_name
DATABASE_URL=postgres://postgres:postgres@localhost:5432/socialflow

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Storage Configuration (Local / GCP Cloud Storage)
STORAGE_TYPE=local
# GCS_BUCKET_NAME=socialflow-media-bucket

# SMTP / Email Configuration (Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@socialflow.app

# Meta Platforms (Facebook & Instagram API)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/platforms/facebook/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/platforms/instagram/callback

# X / Twitter API v2
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/platforms/twitter/callback

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/platforms/linkedin/callback

# Google / YouTube Data API v3
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/platforms/youtube/callback

# Pinterest API v5
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_REDIRECT_URI=http://localhost:3000/api/platforms/pinterest/callback

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
